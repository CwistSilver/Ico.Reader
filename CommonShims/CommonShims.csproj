<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <!--
    The shims back-fill BCL members that netstandard2.0 lacks. They ship inside the Ico.Reader
    package, so they stay internal rather than adding extension methods to consumers' Stream and
    BinaryWriter.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Ico.Reader</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PeDecoder</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Ico.Reader.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
