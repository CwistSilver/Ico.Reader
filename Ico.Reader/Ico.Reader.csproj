<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeReferencedProjectDlls</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <PackageId>Ico.Reader</PackageId>
    <Title>Ico.Reader</Title>
    <Version>0.0.0</Version>
    <Authors>CwistSilver;Der_Floh</Authors>
    <Copyright>Copyright (c) 2024 Gabriel Zerbe</Copyright>
    <Description>Ico.Reader is a cross-platform library designed for extracting icons and cursors from .ico and .cur files, as well as from embedded resources within .exe and .dll files.</Description>
    <PackageTags>Icon;Cursor;Reader;ICO;EXE;DLL;CUR</PackageTags>
    <PackageProjectUrl>https://github.com/CwistSilver/Ico.Reader</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/CwistSilver/Ico.Reader/releases</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ico.Reader.CommonShims\Ico.Reader.CommonShims.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\Ico.Reader.PeDecoder\Ico.Reader.PeDecoder.csproj" PrivateAssets="All" />
  </ItemGroup>

  <!-- Readers and parsers are implementation details, so the tests reach them as internals. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Ico.Reader.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    The referenced projects are packed into this package rather than published as their own, so
    their assemblies have to be added to the build output by hand.
  -->
  <Target Name="IncludeReferencedProjectDlls">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)Ico.Reader.CommonShims.dll" Condition="Exists('$(OutputPath)Ico.Reader.CommonShims.dll')" />
      <BuildOutputInPackage Include="$(OutputPath)Ico.Reader.PeDecoder.dll" Condition="Exists('$(OutputPath)Ico.Reader.PeDecoder.dll')" />
    </ItemGroup>
  </Target>

</Project>
