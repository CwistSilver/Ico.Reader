<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="coverlet.collector" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ico.Reader\Ico.Reader.csproj" />
    <!-- Ico.Reader hides PeDecoder from consumers; the tests assert on its DI registration. -->
    <ProjectReference Include="..\PeDecoder\PeDecoder.csproj" />
    <!-- Ico.Reader routes its span-based reads through CommonShims, so the shims are covered
         directly as well as through the rest of the suite. -->
    <ProjectReference Include="..\CommonShims\CommonShims.csproj" />
    <ProjectReference Include="..\Ico.Reader.Test.PeFixture\Ico.Reader.Test.PeFixture.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The PE fixture is test data, not a dependency, so it is copied next to the other fixtures
       rather than referenced. -->
  <Target Name="CopyPeFixture" AfterTargets="Build">
    <MSBuild Projects="..\Ico.Reader.Test.PeFixture\Ico.Reader.Test.PeFixture.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="PeFixtureAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(PeFixtureAssembly)" DestinationFolder="$(OutputPath)Resources\Pe\" SkipUnchangedFiles="true" />
  </Target>

</Project>
